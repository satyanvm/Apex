        {
          "key": "query",
          "label": "Search query",
          "control": "text",
          "required": true,
          "placeholder": "type:ticket status:open",
          "help": "Zendesk search syntax, e.g. type:ticket status:open"
        }
      ],
      "outputs": [
        "results",
        "count",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "ZENDESK_EMAIL",
          "help": "Agent email address used for API token auth"
        },
        {
          "key": "ZENDESK_API_TOKEN",
          "help": "API token (Admin Center → Apps and integrations → APIs)"
        }
      ],
      "http": {
        "method": "GET",
        "url": "https://{{config.subdomain}}.zendesk.com/api/v2/search.json?query={{urlencode config.query}}",
        "auth": {
          "type": "basic",
          "username": "{{credentials.ZENDESK_EMAIL}}/token",
          "password": "{{credentials.ZENDESK_API_TOKEN}}"
        },
        "outputMap": {
          "results": "results",
          "count": "count"
        }
      }
