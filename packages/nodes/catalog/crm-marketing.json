    {
      "id": "zendesk.createTicket",
      "label": "Zendesk: Create Ticket",
      "description": "Create a support ticket in Zendesk via the Support API v2.",
      "kind": "action",
      "runtime": "http",
      "search": "zendesk ticket create support helpdesk issue customer service",
      "config": [
        {
          "key": "subdomain",
          "label": "Zendesk subdomain",
          "control": "text",
          "required": true,
          "placeholder": "mycompany",
          "help": "The <subdomain> in <subdomain>.zendesk.com"
        },
        {
          "key": "subject",
          "label": "Subject",
          "control": "text",
          "required": true
        },
        {
          "key": "comment",
          "label": "Description",
          "control": "textarea",
          "required": true
        }
      ],
      "outputs": [
        "ticketId",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "ZENDESK_EMAIL",
          "help": "Agent email address used for API token auth"
        },
        {
          "key": "ZENDESK_API_TOKEN",
          "help": "API token (Admin Center → Apps and integrations → APIs)"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://{{config.subdomain}}.zendesk.com/api/v2/tickets.json",
        "auth": {
          "type": "basic",
          "username": "{{credentials.ZENDESK_EMAIL}}/token",
          "password": "{{credentials.ZENDESK_API_TOKEN}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"ticket\": {\"subject\": {{json config.subject}}, \"comment\": {\"body\": {{json config.comment}}}}}",
        "outputMap": {
          "ticketId": "ticket.id"
        }
      }
    },
    {
      "id": "zendesk.searchTickets",
      "label": "Zendesk: Search Tickets",
      "description": "Search tickets and other objects in Zendesk via the Support API search endpoint.",
      "kind": "action",
