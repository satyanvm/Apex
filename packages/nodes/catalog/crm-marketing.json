        {
          "key": "bodyText",
          "label": "Body",
          "control": "textarea",
          "required": true,
          "help": "Markdown supported"
        }
      ],
      "outputs": [
        "id",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "BUTTONDOWN_API_KEY",
          "help": "API key (Settings → API)"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://api.buttondown.com/v1/emails",
        "headers": {
          "Authorization": "Token {{credentials.BUTTONDOWN_API_KEY}}",
          "Content-Type": "application/json"
        },
        "body": "{\"subject\": {{json config.subject}}, \"body\": {{json config.bodyText}}}",
        "outputMap": {
          "id": "id"
        }
      }
    }
  ]
}
