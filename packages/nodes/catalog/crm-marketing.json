{
  "cluster": "crm-marketing",
  "label": "CRM & Marketing",
  "description": "CRM, marketing, support-desk and email-marketing services.",
  "nodes": [
    {
      "id": "hubspot.createContact",
      "label": "HubSpot: Create Contact",
      "description": "Create a contact in HubSpot CRM via the crm/v3 objects API.",
      "kind": "action",
      "runtime": "http",
      "search": "hubspot crm contact create lead person email marketing sales",
      "config": [
        {
          "key": "email",
          "label": "Email",
          "control": "text",
          "required": true,
          "placeholder": "user@example.com"
        },
        {
          "key": "firstname",
          "label": "First name",
          "control": "text",
          "required": false
        },
        {
          "key": "lastname",
          "label": "Last name",
          "control": "text",
          "required": false
        }
      ],
      "outputs": [
        "id",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "HUBSPOT_ACCESS_TOKEN",
          "help": "Private app access token with crm.objects.contacts.write scope"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts",
        "headers": {
          "Authorization": "Bearer {{credentials.HUBSPOT_ACCESS_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": "{\"properties\": {\"email\": {{json config.email}}, \"firstname\": {{json config.firstname}}, \"lastname\": {{json config.lastname}}}}",
        "outputMap": {
          "id": "id"
        }
      }
    },
    {
      "id": "hubspot.listContacts",
      "label": "HubSpot: List Contacts",
      "description": "Read a page of contacts from HubSpot CRM via the crm/v3 objects API.",
      "kind": "action",
      "runtime": "http",
      "search": "hubspot crm contacts list read page fetch leads people",
      "config": [
        {
          "key": "limit",
          "label": "Page size",
          "control": "text",
          "required": true,
          "placeholder": "20",
          "help": "Number of contacts per page (max 100)"
        }
      ],
      "outputs": [
        "results",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "HUBSPOT_ACCESS_TOKEN",
          "help": "Private app access token with crm.objects.contacts.read scope"
        }
      ],
      "http": {
        "method": "GET",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts?limit={{urlencode config.limit}}",
        "headers": {
          "Authorization": "Bearer {{credentials.HUBSPOT_ACCESS_TOKEN}}"
        },
        "outputMap": {
          "results": "results"
        }
      }
    },
    {
      "id": "hubspot.createDeal",
      "label": "HubSpot: Create Deal",
      "description": "Create a deal in HubSpot CRM via the crm/v3 objects API.",
      "kind": "action",
      "runtime": "http",
      "search": "hubspot crm deal create opportunity pipeline sales amount",
      "config": [
        {
          "key": "dealname",
          "label": "Deal name",
          "control": "text",
          "required": true
        },
        {
          "key": "amount",
          "label": "Amount",
          "control": "text",
          "required": false,
          "placeholder": "1500"
        },
        {
          "key": "dealstage",
          "label": "Deal stage",
          "control": "text",
          "required": false,
          "placeholder": "appointmentscheduled",
          "help": "Internal stage ID from your pipeline"
        }
      ],
      "outputs": [
        "id",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "HUBSPOT_ACCESS_TOKEN",
          "help": "Private app access token with crm.objects.deals.write scope"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/deals",
        "headers": {
          "Authorization": "Bearer {{credentials.HUBSPOT_ACCESS_TOKEN}}",
          "Content-Type": "application/json"
        },
        "body": "{\"properties\": {\"dealname\": {{json config.dealname}}, \"amount\": {{json config.amount}}, \"dealstage\": {{json config.dealstage}}}}",
        "outputMap": {
          "id": "id"
        }
      }
    },
    {
      "id": "mailchimp.addListMember",
      "label": "Mailchimp: Add List Member",
      "description": "Add or subscribe a member to a Mailchimp audience (list) via the Marketing API v3.",
      "kind": "action",
      "runtime": "http",
      "search": "mailchimp subscribe member audience list email newsletter marketing add",
      "config": [
        {
          "key": "dc",
          "label": "Data center",
          "control": "text",
          "required": true,
          "placeholder": "us21",
          "help": "The suffix of your API key (after the dash), e.g. us21"
        },
        {
          "key": "listId",
          "label": "Audience (list) ID",
          "control": "text",
          "required": true
        },
        {
          "key": "email",
          "label": "Email address",
          "control": "text",
          "required": true
        },
        {
          "key": "memberStatus",
          "label": "Status",
          "control": "text",
          "required": true,
          "placeholder": "subscribed",
          "help": "subscribed, unsubscribed, cleaned, pending or transactional"
        }
      ],
      "outputs": [
        "id",
        "email_address",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "MAILCHIMP_API_KEY",
          "help": "Marketing API key (ends in -<dc>)"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://{{config.dc}}.api.mailchimp.com/3.0/lists/{{config.listId}}/members",
        "auth": {
          "type": "basic",
          "username": "anystring",
          "password": "{{credentials.MAILCHIMP_API_KEY}}"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"email_address\": {{json config.email}}, \"status\": {{json config.memberStatus}}}",
        "outputMap": {
          "id": "id",
          "email_address": "email_address"
        }
      }
    },
    {
      "id": "mailchimp.listCampaigns",
      "label": "Mailchimp: List Campaigns",
      "description": "List campaigns in a Mailchimp account via the Marketing API v3.",
      "kind": "action",
      "runtime": "http",
      "search": "mailchimp campaigns list newsletter email marketing fetch read",
      "config": [
        {
          "key": "dc",
          "label": "Data center",
          "control": "text",
          "required": true,
          "placeholder": "us21",
          "help": "The suffix of your API key (after the dash), e.g. us21"
        },
        {
          "key": "count",
          "label": "Count",
          "control": "text",
          "required": true,
          "placeholder": "10",
          "help": "Number of records to return (max 1000)"
        }
      ],
      "outputs": [
        "campaigns",
        "totalItems",
        "status",
        "body",
        "total_items"
      ],
      "credentials": [
        {
          "key": "MAILCHIMP_API_KEY",
          "help": "Marketing API key (ends in -<dc>)"
        }
      ],
      "http": {
        "method": "GET",
        "url": "https://{{config.dc}}.api.mailchimp.com/3.0/campaigns?count={{urlencode config.count}}",
        "auth": {
          "type": "basic",
          "username": "anystring",
          "password": "{{credentials.MAILCHIMP_API_KEY}}"
        },
        "outputMap": {
          "campaigns": "campaigns",
          "total_items": "totalItems"
        }
      }
    },
    {
      "id": "intercom.createContact",
      "label": "Intercom: Create Contact",
      "description": "Create a contact (user or lead) in Intercom via the REST API.",
      "kind": "action",
      "runtime": "http",
      "search": "intercom contact create user lead customer crm support",
      "config": [
        {
          "key": "email",
          "label": "Email",
          "control": "text",
          "required": true
        },
        {
          "key": "name",
          "label": "Name",
          "control": "text",
          "required": false
        },
        {
          "key": "role",
          "label": "Role",
          "control": "text",
          "required": true,
          "placeholder": "user",
          "help": "user or lead"
        }
      ],
      "outputs": [
        "id",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "INTERCOM_ACCESS_TOKEN",
          "help": "Access token from your Intercom app (Developer Hub)"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts",
        "headers": {
          "Authorization": "Bearer {{credentials.INTERCOM_ACCESS_TOKEN}}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": "{\"role\": {{json config.role}}, \"email\": {{json config.email}}, \"name\": {{json config.name}}}",
        "outputMap": {
          "id": "id"
        }
      }
    },
    {
      "id": "intercom.listConversations",
