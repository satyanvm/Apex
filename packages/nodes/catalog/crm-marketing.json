    {
      "id": "brevo.sendEmail",
      "label": "Brevo: Send Transactional Email",
      "description": "Send a transactional email via the Brevo (formerly Sendinblue) v3 API.",
      "kind": "action",
      "runtime": "http",
      "search": "brevo sendinblue email send transactional mail deliver smtp",
      "config": [
        {
          "key": "fromEmail",
          "label": "From email",
          "control": "text",
          "required": true,
          "help": "A verified sender address"
        },
        {
          "key": "to",
          "label": "To",
          "control": "text",
          "required": true,
          "placeholder": "user@example.com"
        },
        {
          "key": "subject",
          "label": "Subject",
          "control": "text",
          "required": true
        },
        {
          "key": "text",
          "label": "Body",
          "control": "textarea",
          "required": true
        }
      ],
      "outputs": [
        "messageId",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "BREVO_API_KEY",
          "help": "API key (SMTP & API → API keys)"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "headers": {
          "api-key": "{{credentials.BREVO_API_KEY}}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": "{\"sender\": {\"email\": {{json config.fromEmail}}}, \"to\": [{\"email\": {{json config.to}}}], \"subject\": {{json config.subject}}, \"textContent\": {{json config.text}}}",
        "outputMap": {
          "messageId": "messageId"
        }
      }
    },
