      "search": "todoist tasks list todo active fetch read open items",
      "config": [],
      "outputs": [
        "results",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "TODOIST_API_TOKEN",
          "help": "API token from Todoist Settings → Integrations → Developer"
        }
      ],
      "http": {
        "method": "GET",
        "url": "https://api.todoist.com/api/v1/tasks",
        "headers": {
          "Authorization": "Bearer {{credentials.TODOIST_API_TOKEN}}"
        },
        "outputMap": {
          "results": "results"
        }
      }
    },
    {
      "id": "trello.createCard",
      "label": "Trello: Create Card",
      "description": "Create a card on a Trello list via the REST API.",
      "kind": "action",
      "runtime": "http",
      "search": "trello card create board list kanban task add ticket",
      "config": [
        {
          "key": "listId",
          "label": "List ID",
          "control": "text",
          "required": true,
          "help": "ID of the list to add the card to"
        },
        {
          "key": "name",
          "label": "Card name",
          "control": "text",
          "required": true
        },
        {
          "key": "desc",
          "label": "Description",
          "control": "textarea",
          "required": false
        }
      ],
      "outputs": [
        "id",
        "url",
        "shortUrl",
        "status",
        "body"
      ],
      "credentials": [
        {
          "key": "TRELLO_API_KEY",
          "help": "API key from trello.com/power-ups/admin"
        },
        {
          "key": "TRELLO_API_TOKEN",
          "help": "Member token authorized for your API key"
        }
      ],
      "http": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards?idList={{urlencode config.listId}}&name={{urlencode config.name}}&desc={{urlencode config.desc}}&key={{urlencode credentials.TRELLO_API_KEY}}&token={{urlencode credentials.TRELLO_API_TOKEN}}",
        "headers": {},
        "outputMap": {
          "id": "id",
          "url": "url",
          "shortUrl": "shortUrl"
        }
      }
    },
