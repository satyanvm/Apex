# Agently local environment
# Copy this file to .env and replace every required value before starting services.

# ── Durable storage ─────────────────────────────────────────────────────────
# Shared by the API, reasoner, and pieces worker.
DATABASE_URL=postgresql://agently:agently@localhost:5433/agently

# ── API / web ────────────────────────────────────────────────────────────────
# Access control. The API requires `Authorization: Bearer $AGENTLY_API_TOKEN`
# on every route except /api/health and webhook ingress (/api/hooks/*); the web
# proxy attaches it server-side. Required when ENV=production; generate one with
#   openssl rand -hex 32
AGENTLY_API_TOKEN=
# Encrypts stored third-party credentials (AES-256-GCM). Shared by the API,
# reasoner, and pieces worker; required when ENV=production. Keep it safe:
# losing it makes stored credentials unreadable. openssl rand -hex 32
AGENTLY_CREDENTIALS_KEY=
# When set, the web app asks for this password (HTTP Basic auth, any username).
AGENTLY_WEB_PASSWORD=
# Origins allowed to call the API cross-origin (comma-separated). Defaults to
# localhost; the web app itself is same-origin through its proxy.
# CORS_ORIGINS=https://agently.example.com
# ENV=production
API_ADDR=:8090
API_PROXY_TARGET=http://localhost:8090
APP_BASE_URL=http://localhost:3000
SCHEDULER_TZ=UTC
# Set to 0 when another instance owns schedule and piece polling.
SCHEDULER=1
PIECES_POLLER=1

# ── Planner and embeddings ──────────────────────────────────────────────────
# Route + map run on a cheap model; reduce (graph authorship) on a stronger one.
# The provider follows the model name: ollama/<model> runs on a local Ollama
# (no key; e.g. ollama/qwen3:8b — ollama pull qwen3:8b), kimi-*/moonshot-* on
# the OpenAI-compatible Moonshot API (MOONSHOT_API_KEY), anything else on Gemini.
# Free-tier Gemini keys allow ~5 req/min on non-lite flash models; route+map
# fans out ~13 calls per prompt, so keep it on a flash-lite model.
GEMINI_API_KEY=
PLANNER_MAP_MODEL=gemini-3.1-flash-lite
PLANNER_MODEL=gemini-3.5-flash
# Used for planner reduce calls when PLANNER_MODEL's daily quota is used up
# (Gemini free tier caps requests per day). Leave empty to fail instead.
PLANNER_FALLBACK_MODEL=
# Planner size limits. The graph-writing model sizes each graph itself: up to
# PLANNER_SECTION_THRESHOLD nodes it writes the graph in one call; above that it
# returns an outline and the graph is written one section per call, so 80+ node
# graphs fit. Use a Gemini (or
# Kimi) PLANNER_MODEL for large graphs; small local models rarely manage them.
# Raise MAX_CLUSTERS / MAX_NODE_TYPES for requests spanning many different apps.
# PLANNER_MAX_CLUSTERS=16
# PLANNER_MAX_NODE_TYPES=48
# PLANNER_MAX_NODES_PER_CLUSTER=12
# PLANNER_REDUCE_MAX_TOKENS=32000
# PLANNER_REDUCE_TIMEOUT_S=180
# PLANNER_SECTION_THRESHOLD=25
# MOONSHOT_API_KEY=            # only when PLANNER_MODEL=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Catalog embeddings (prefilter over ~6.7k Activepieces nodes). The provider
# follows the model name:
#   ollama/<model>          local Ollama, no key, no quota (brew install ollama;
#                           ollama pull nomic-embed-text)
#   gemini-embedding-001    GEMINI_API_KEY (free tier: ~1k embeds/day)
#   text-embedding-3-small  OPENAI_API_KEY
# Regenerate the sidecar after changing: cd apps/pieces-worker && npm run gen:embeddings
PLANNER_EMBED_MODEL=ollama/nomic-embed-text
PLANNER_EMBED_DIMS=768
# OLLAMA_HOST=http://localhost:11434

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_HOSTPORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agently-reasoner
PIECES_TASK_QUEUE=agently-pieces

# ── Reasoner ─────────────────────────────────────────────────────────────────
# ollama/<model> works here too; GEMINI_API_KEY is then not required.
REASONER_MODEL=gemini-3.5-flash-lite
# User-Agent for catalog HTTP nodes; public APIs like Wikipedia reject a bare
# client UA. Put a contact URL or email in it for production.
HTTP_USER_AGENT=
# Catalog HTTP nodes: request timeout (seconds), and whether a failed GET
# (rate limit, outage) leaves its outputs empty and lets the run continue
# (1, default) or fails the run (0).
HTTP_TIMEOUT_S=60
HTTP_SOFT_FAIL=1
# Most nodes of one run that execute at once; independent branches of a graph
# run side by side up to this cap (1 = one node at a time).
RUN_MAX_PARALLEL=8
# Before a manual run starts, the API checks that every node can resolve its
# account (a selected credential or the env fallback) and asks for the missing
# ones. Set to off when the reasoner/pieces worker get tokens from an env the
# API process cannot see.
RUN_CREDENTIAL_CHECK=on
REASONER_SYNTHESIS_MODEL=gemini-3.5-flash-lite
# Context window for every ollama/<model> call (Ollama's default truncates
# silently; the planner's largest prompt is ~10k tokens).
# OLLAMA_NUM_CTX=16384
REASONER_DISPATCH_INTERVAL_S=1.5

# Langfuse is required so every run has a trace. docker-compose.langfuse.yml
# bootstraps exactly these keys (UI login: dev@agently.local / agently-dev-pw).
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-agently-local
LANGFUSE_SECRET_KEY=sk-lf-agently-local

# Browser nodes use real Browserbase sessions; unset credentials are startup
# errors, not a simulated browser.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# output.email requires SMTP. Use an app password where your provider supports it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional explicit execution gates. A disabled tool is an error when selected.
TOOL_CODE_ENABLED=0
TOOL_DB_URL=

# ── Piece credentials ───────────────────────────────────────────────────────
# Piece actions resolve stored credential IDs through DATABASE_URL. Environment
# values may still be used for piece-specific auth where the catalog allows it.
# AP_SLACK_AUTH=
# AP_STRIPE_AUTH=
